# ==============================================================================
# StreamGuard Environment Configuration Example
# ==============================================================================

# Database Configuration (Async PostgreSQL with asyncpg)
STREAMGUARD_DATABASE_URL=postgresql+asyncpg://streamguard:streamguard_secret@localhost:5432/streamguard

# Redis Configuration (Streams, Cache, State)
STREAMGUARD_REDIS_URL=redis://localhost:6379/0

# Security / JWT Authentication
STREAMGUARD_JWT_SECRET=streamguard-dev-secret-change-in-production
STREAMGUARD_JWT_ALGORITHM=HS256

# Rate Limiting Engine
STREAMGUARD_RATE_LIMIT_MAX_VIOLATIONS=3
STREAMGUARD_RATE_LIMIT_WINDOW_SECONDS=10

# Redis Stream Worker Engine
STREAMGUARD_WORKER_BATCH_SIZE=50
STREAMGUARD_WORKER_BLOCK_MS=5000

# Cache Configuration
STREAMGUARD_CACHE_TTL_SECONDS=300

# Meta FastText NLP Moderation Engine & Hugging Face Hub
# Leave empty to use local auto-trained FastText model
# STREAMGUARD_FASTTEXT_MODEL_PATH=./app/nlp/models/fasttext_streamguard.bin
# STREAMGUARD_HUGGINGFACE_REPO_ID=krsrep/CL-toxicity-fasttext
# STREAMGUARD_HUGGINGFACE_FILENAME=model.bin
# STREAMGUARD_HUGGINGFACE_TOKEN=hf_your_token_here
